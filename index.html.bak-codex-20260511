    aiSuggShow(['5,000','15,000','30,000','50,000','80,000','120,000','200,000+']);
    return;
  }
  // ── KM ──
  if(aiStep===5){
    aiData.km=val;aiStep=6;
    aiMsg('bot','¿De qué color?');
    aiSuggShow(COLORES.slice(0,6));
    return;
  }
  // ── COLOR ──
