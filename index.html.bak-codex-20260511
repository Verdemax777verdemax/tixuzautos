    aiData.color=val;aiStep=7;
    aiMsg('bot','¿En qué ciudad está el auto?');
    aiSuggShow(CIUDADES.slice(0,6));
    return;
  }
  // ── CIUDAD ──
  if(aiStep===7){
    aiData.ciudad=val;aiStep=8;
