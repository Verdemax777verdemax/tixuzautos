<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0f1623;--bg2:#161e2e;--bg3:#1e2a3d;--bg4:#263248;
  --border:#2a3750;
  --text:#f0f4ff;--text2:#8fa3c0;--text3:#4f6885;
  --accent:#3b82f6;--accent2:#2563eb;
  --green:#10b981;--green2:#059669;
  --gold:#f59e0b;--purple:#7c3aed;--danger:#ef4444;
  --radius:12px;--shadow:0 8px 32px rgba(0,0,0,.5);
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
a{color:inherit;text-decoration:none}
button{cursor:pointer;border:none;font-family:inherit}
input,select,textarea{font-family:inherit}

/* ── HEADER ── */
header{
  position:sticky;top:0;z-index:100;
  background:rgba(15,22,35,.96);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:0 20px;height:60px;
  display:flex;align-items:center;gap:10px;
}
.logo{display:flex;align-items:center;gap:8px;font-size:1.05rem;font-weight:800;white-space:nowrap}
.logo-icon{width:30px;height:30px;background:linear-gradient(135deg,var(--accent),var(--purple));border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
.logo-txt{line-height:1}
.logo-sub{font-size:.55rem;font-weight:500;color:var(--text3);letter-spacing:2px;text-transform:uppercase}
.hbtns{margin-left:auto;display:flex;gap:6px;align-items:center;flex-shrink:0}
.hbtn{padding:7px 13px;border-radius:8px;font-size:.78rem;font-weight:700;display:inline-flex;align-items:center;gap:5px;transition:all .15s;white-space:nowrap;border:1px solid transparent}
.hbtn-ai{background:rgba(59,130,246,.15);color:var(--accent);border-color:rgba(59,130,246,.3)}
.hbtn-ai:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
.hbtn-gold{background:rgba(245,158,11,.12);color:var(--gold);border-color:rgba(245,158,11,.25)}
.hbtn-gold:hover{background:var(--gold);color:#000;border-color:var(--gold)}
.hbtn-green{background:var(--green);color:#fff}
.hbtn-green:hover{background:var(--green2)}
.hbtn-ghost{background:rgba(255,255,255,.06);color:var(--text2);border-color:var(--border)}
.hbtn-ghost:hover{color:var(--text);background:rgba(255,255,255,.1)}
.admin-lite{display:none!important}
body.show-admin .admin-lite{display:inline-flex!important}

/* ── HERO ── */
.hero{
  text-align:center;padding:44px 20px 28px;
  background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(59,130,246,.07) 0%,transparent 70%);
}
.hero h1{font-size:clamp(1.7rem,5vw,3rem);font-weight:800;line-height:1.1;margin-bottom:10px}
.hero h1 em{font-style:normal;background:linear-gradient(135deg,#3b82f6,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{font-size:.95rem;color:var(--text2);max-width:500px;margin:0 auto 20px}
.hero-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:16px}
.hbtn-hero{padding:11px 24px;border-radius:10px;font-size:.95rem;font-weight:700;display:inline-flex;align-items:center;gap:7px;transition:all .15s}
.hbtn-hero.g{background:var(--green);color:#fff}
.hbtn-hero.g:hover{background:var(--green2);transform:translateY(-1px)}
.hbtn-hero.s{background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;box-shadow:0 8px 22px rgba(59,130,246,.22)}
.hbtn-hero.s:hover{filter:brightness(1.06);transform:translateY(-1px)}
.hbtn-hero.b{background:rgba(59,130,246,.15);color:var(--accent);border:1px solid rgba(59,130,246,.3)}
.hbtn-hero.b:hover{background:var(--accent);color:#fff}
.pills{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;font-size:.75rem;color:var(--text3)}
.pills span{background:var(--bg3);border:1px solid var(--border);padding:3px 11px;border-radius:20px}

/* ── FILTERS ── */
.filters{
  background:var(--bg2);border-bottom:1px solid var(--border);
  padding:10px 20px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;
}
.fi{
  background:var(--bg3);border:1px solid var(--border);color:var(--text);
  padding:7px 11px;border-radius:8px;font-size:.8rem;outline:none;
  transition:border-color .15s;min-width:110px;
}
.fi:focus{border-color:var(--accent)}
.fi::placeholder{color:var(--text3)}
.fi-sort{margin-left:auto}

/* ── GRID ── */
.grid-hdr{padding:12px 20px 4px;display:flex;align-items:center;gap:8px}
.grid-count{font-weight:700;font-size:.9rem}
.grid-count span{color:var(--text3);font-weight:400}
.cars-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
  gap:14px;padding:0 20px 60px;
}

/* ── CAR CARD ── */
.car-card{
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);
  overflow:hidden;cursor:pointer;
  transition:transform .15s,border-color .15s,box-shadow .15s;
  position:relative;
}
.car-card:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:var(--shadow)}
.cimg{position:relative;height:180px;overflow:hidden;background:var(--bg3)}
.cimg img{width:100%;height:100%;object-fit:cover;transition:transform .3s;display:block}
.car-card:hover .cimg img{transform:scale(1.04)}
.cimg-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.8rem}
.cbadge{
  position:absolute;top:9px;left:9px;
  font-size:.67rem;font-weight:800;padding:2px 9px;border-radius:20px;
  letter-spacing:.4px;text-transform:uppercase;
}
.bp{background:linear-gradient(135deg,#7c3aed,#ec4899);color:#fff}
.bf{background:linear-gradient(135deg,#f59e0b,#ef4444);color:#fff}
.cstype{
  position:absolute;top:9px;right:9px;
  font-size:.65rem;font-weight:700;padding:2px 7px;border-radius:5px;
  background:rgba(0,0,0,.65);color:#fff;backdrop-filter:blur(4px);
}
.cbody{padding:12px}
.ctitle{font-weight:700;font-size:.9rem;margin-bottom:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cprice{font-size:1.2rem;font-weight:800;color:var(--accent);margin-bottom:7px}
.cmeta{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px}
.cmeta span{font-size:.7rem;color:var(--text3);background:var(--bg3);padding:2px 8px;border-radius:20px}
.cloc{font-size:.74rem;color:var(--text3);display:flex;justify-content:space-between;align-items:center}

/* ── EMPTY ── */
.empty{text-align:center;padding:50px 20px;grid-column:1/-1;color:var(--text3)}
.empty h3{font-size:1rem;color:var(--text2);margin-bottom:4px}

/* ── OVERLAY / MODAL ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;align-items:center;justify-content:center;padding:14px}
.overlay.open{display:flex}
.modal{background:var(--bg2);border:1px solid var(--border);border-radius:16px;width:100%;max-width:560px;max-height:92vh;overflow-y:auto;box-shadow:0 32px 80px rgba(0,0,0,.7)}
.modal-lg{max-width:820px}
.mhdr{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--bg2);z-index:1}
.mhdr h2{font-size:.95rem;font-weight:700}
.mclose{background:var(--bg3);border:none;color:var(--text2);width:28px;height:28px;border-radius:7px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.mclose:hover{color:var(--text)}
.mbody{padding:16px 20px}
.mfoot{padding:12px 20px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end}

/* ── SELL STEPS ── */
.steps{display:flex;border-radius:8px;overflow:hidden;border:1px solid var(--border);margin-bottom:18px}
.stab{flex:1;padding:8px;text-align:center;font-size:.74rem;font-weight:600;background:var(--bg3);color:var(--text3);border-right:1px solid var(--border)}
.stab:last-child{border-right:none}
.stab.active{background:var(--accent);color:#fff}
.stab.done{background:var(--green);color:#fff}

/* ── FORM ── */
.fg{margin-bottom:12px}
.fg label{display:block;font-size:.8rem;font-weight:600;color:var(--text2);margin-bottom:4px}
.fg input,.fg select,.fg textarea{width:100%;background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:8px 11px;border-radius:8px;font-size:.85rem;outline:none;transition:border-color .15s}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--accent)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fhint{font-size:.72rem;color:var(--text3);margin-top:3px}
.ferr{font-size:.75rem;color:var(--danger);margin-top:3px;display:none}
.btn{padding:8px 16px;border-radius:8px;font-size:.83rem;font-weight:700;display:inline-flex;align-items:center;gap:5px;transition:all .15s;cursor:pointer;border:none}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent2)}
.btn-green{background:var(--green);color:#fff}
.btn-green:hover{background:var(--green2)}
.btn-ghost{background:transparent;color:var(--text2);border:1px solid var(--border)}
.btn-ghost:hover{color:var(--text);border-color:var(--accent)}
.btn-danger{background:var(--danger);color:#fff}

/* ── PLAN CARDS ── */
.pcards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.pcard{border:2px solid var(--border);border-radius:10px;padding:12px 8px;cursor:pointer;transition:all .15s;text-align:center}
.pcard.sel,.pcard:hover{border-color:var(--accent);background:rgba(59,130,246,.05)}
.pcard h4{font-size:.84rem;font-weight:700;margin-bottom:3px}
.pcard .pp{font-size:1.2rem;font-weight:800;color:var(--green)}
.pcard .pp sub{font-size:.6rem;font-weight:400;color:var(--text3)}
.pcard ul{list-style:none;text-align:left;font-size:.7rem;color:var(--text2);margin-top:6px;line-height:1.8}
.pcard ul li::before{content:"✓ "}

/* ── PHOTO GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:8px}
.pslot{aspect-ratio:4/3;border:2px dashed var(--border);border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font-size:.68rem;color:var(--text3);position:relative;overflow:hidden;background:var(--bg3);transition:border-color .15s}
.pslot:hover{border-color:var(--accent)}
.pslot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

@media (max-height:760px){
  #sellOv .modal{max-height:88vh}
  #sellOv .mbody{padding:12px 16px}
  #sellOv .fg{margin-bottom:8px}
  #sellOv .pgrid{gap:5px}
  #sellOv .pslot{aspect-ratio:16/10;font-size:.62rem}
  #sellOv .pcard{padding:10px}
}
.prm{position:absolute;top:3px;right:3px;background:rgba(0,0,0,.7);color:#fff;border:none;border-radius:4px;width:18px;height:18px;font-size:.75rem;cursor:pointer;display:flex;align-items:center;justify-content:center}

/* ── DETAIL extras (v66) ── */
.trust-row{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 12px}
.trust-chip{font-size:.7rem;font-weight:600;padding:3px 9px;border-radius:20px;background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.3)}
.detail-note{border:1px solid var(--border);background:rgba(59,130,246,.08);border-radius:12px;padding:12px;margin-top:12px;color:var(--text2);font-size:.84rem;line-height:1.5}
.detail-actions{display:flex;gap:8px;margin-top:14px}
.inventory-notice{display:none;margin:12px 20px 0;padding:11px 14px;border:1px solid rgba(59,130,246,.25);background:rgba(59,130,246,.06);border-radius:12px;font-size:.82rem;color:var(--text2);line-height:1.45}
.inventory-notice button{margin-left:8px;background:var(--accent);color:#fff;border:none;padding:5px 11px;border-radius:6px;font-size:.74rem;font-weight:600;cursor:pointer}
.inventory-notice button:hover{background:var(--accent2)}

/* ── DETAIL ── */
.dgal{display:flex;gap:7px;overflow-x:auto;margin-bottom:14px;padding-bottom:3px}
.dgal img{height:200px;min-width:240px;object-fit:cover;border-radius:8px;flex-shrink:0}
.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.di label{font-size:.7rem;color:var(--text3);display:block;margin-bottom:1px}
.di span{font-size:.88rem;font-weight:600}

/* ── MY LISTINGS ── */
.lrow{display:flex;align-items:center;gap:9px;padding:9px;background:var(--bg3);border-radius:8px;margin-bottom:5px}
.lrow img{width:52px;height:52px;object-fit:cover;border-radius:5px;flex-shrink:0;background:var(--bg4)}
.lrow-info{flex:1;min-width:0}
.lrow-t{font-weight:700;font-size:.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lrow-m{font-size:.72rem;color:var(--text3)}
.lrow-s{font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:20px}
.sa{background:rgba(16,185,129,.15);color:var(--green)}
.sp{background:rgba(245,158,11,.15);color:var(--gold)}
.ss{background:rgba(100,116,139,.15);color:var(--text3)}

/* ── ADMIN ── */
.atabs{display:flex;border-bottom:1px solid var(--border);margin-bottom:14px}
.atab{padding:8px 12px;font-size:.78rem;font-weight:600;color:var(--text3);border-bottom:2px solid transparent;cursor:pointer;background:none}
.atab.active{color:var(--accent);border-bottom-color:var(--accent)}
.atable{width:100%;border-collapse:collapse;font-size:.74rem}
.atable th{text-align:left;padding:6px;color:var(--text3);border-bottom:1px solid var(--border)}
.atable td{padding:6px;border-bottom:1px solid var(--border);vertical-align:middle}

/* ── AI PANEL ── */
.ai-fab{
  position:fixed;bottom:24px;right:24px;z-index:150;
  width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--purple));
  border:none;color:#fff;font-size:1.3rem;cursor:pointer;
  box-shadow:0 4px 20px rgba(59,130,246,.5);
  display:flex;align-items:center;justify-content:center;
  transition:transform .2s,box-shadow .2s;
}
.ai-fab:hover{transform:scale(1.1);box-shadow:0 6px 28px rgba(59,130,246,.7)}
.ai-pulse{position:absolute;width:100%;height:100%;border-radius:50%;background:rgba(59,130,246,.3);animation:pulse 2s infinite;pointer-events:none}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.2);opacity:0}}

.ai-panel{
  position:fixed;bottom:88px;right:24px;z-index:150;
  width:336px;height:510px;
  background:var(--bg2);border:1px solid var(--border);border-radius:16px;
  box-shadow:0 16px 48px rgba(0,0,0,.6);
  display:flex;flex-direction:column;
  transform:scale(.95) translateY(10px);opacity:0;pointer-events:none;
  transition:all .22s cubic-bezier(.34,1.56,.64,1);
}
.ai-panel.open{transform:scale(1) translateY(0);opacity:1;pointer-events:auto}
.ai-hdr{padding:11px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:9px;flex-shrink:0}
.ai-hdr-ico{width:34px;height:34px;border-radius:9px;flex-shrink:0;background:linear-gradient(135deg,var(--accent),var(--purple));display:flex;align-items:center;justify-content:center;font-size:1rem}
.ai-hdr h3{font-size:.84rem;font-weight:700}
.ai-hdr p{font-size:.68rem;color:var(--green)}
.ai-hdr-x{margin-left:auto;background:none;border:none;color:var(--text3);cursor:pointer;font-size:.95rem;padding:4px}
.ai-msgs{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:7px;scroll-behavior:smooth}
.ai-msg{max-width:88%;padding:8px 11px;border-radius:12px;font-size:.79rem;line-height:1.45;white-space:pre-wrap}
.ai-msg.bot{background:var(--bg3);border:1px solid var(--border);align-self:flex-start;border-radius:3px 12px 12px 12px}
.ai-msg.user{background:var(--accent);color:#fff;align-self:flex-end;border-radius:12px 3px 12px 12px}
.ai-suggs{display:flex;flex-wrap:wrap;gap:5px;padding:0 10px 6px;flex-shrink:0}
.aisg{padding:5px 11px;border-radius:20px;font-size:.74rem;font-weight:600;border:1px solid var(--border);color:var(--text2);background:var(--bg3);cursor:pointer;transition:all .12s;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.aisg:hover,.aisg.hl{background:var(--accent);color:#fff;border-color:var(--accent)}
.ai-iw{padding:8px 10px;border-top:1px solid var(--border);display:flex;gap:7px;align-items:center;flex-shrink:0}
.ai-inp{flex:1;background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:7px 11px;border-radius:20px;font-size:.79rem;outline:none;transition:border-color .15s}
.ai-inp:focus{border-color:var(--accent)}
.ai-send{width:32px;height:32px;border-radius:50%;background:var(--accent);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.85rem;transition:background .15s}
.ai-send:hover{background:var(--accent2)}
.aidots{display:flex;gap:4px;align-items:center;padding:7px 11px;background:var(--bg3);border:1px solid var(--border);border-radius:3px 12px 12px 12px;width:fit-content}
.aidot{width:5px;height:5px;border-radius:50%;background:var(--text3);animation:dot .8s infinite}
.aidot:nth-child(2){animation-delay:.15s}
.aidot:nth-child(3){animation-delay:.3s}
@keyframes dot{0%,80%,100%{transform:scale(.8);opacity:.4}40%{transform:scale(1.2);opacity:1}}

/* ── TOAST ── */
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--bg2);border:1px solid var(--border);color:var(--text);padding:10px 18px;border-radius:9px;font-size:.84rem;font-weight:600;z-index:999;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:opacity .25s;white-space:nowrap}
.toast.show{opacity:1}
.toast.success{border-color:var(--green);color:var(--green)}
.toast.error{border-color:var(--danger);color:var(--danger)}
.spin{display:inline-block;width:16px;height:16px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

/* ── FOOTER ── */
footer{background:var(--bg2);border-top:1px solid var(--border);padding:32px 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:24px}
.fs h4{font-size:.82rem;font-weight:700;margin-bottom:9px}
.fs a,.fs p{font-size:.76rem;color:var(--text3);display:block;margin-bottom:3px}
.fs a:hover{color:var(--text)}
.fb{text-align:center;padding:12px;border-top:1px solid var(--border);font-size:.74rem;color:var(--text3)}

@media(max-width:640px){
  .pcards{grid-template-columns:1fr}
  .frow{grid-template-columns:1fr}
  .dgrid{grid-template-columns:1fr}
  .cars-grid{grid-template-columns:1fr 1fr}
  .ai-panel{width:calc(100vw - 28px);right:14px;bottom:78px}
  header{padding:0 10px}
  .hbtn{padding:6px 9px;font-size:.72rem}
}
@media(max-width:380px){.cars-grid{grid-template-columns:1fr}}
/* ── MOBILE FIX V51: solo responsive, desktop intacto ── */
@media (max-width: 640px){
  html,body{width:100%;max-width:100%;overflow-x:hidden}
  body{min-width:0;-webkit-text-size-adjust:100%}
  header{height:auto;min-height:56px;padding:8px 10px;gap:8px;align-items:flex-start;flex-wrap:wrap}
  .logo{flex:1 1 auto;min-width:150px;font-size:1rem}
  .logo-icon{width:28px;height:28px}
  .logo-sub{font-size:.5rem;letter-spacing:1.5px}
  .hbtns{width:100%;margin-left:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
  .hbtn{width:100%;justify-content:center;min-height:34px;padding:7px 8px;font-size:.72rem;line-height:1.1;white-space:normal;text-align:center}
  .hero{padding:28px 12px 22px}
  .hero h1{font-size:2.05rem;line-height:1.05;margin-bottom:8px}
  .hero p{font-size:.88rem;max-width:330px;margin-bottom:16px}
  .hbtn-hero{width:100%;max-width:260px;justify-content:center}
  .hero-btns{gap:8px;margin-bottom:14px}
  .hero-btns .hbtn-hero.s{order:1}
  .hero-btns .hbtn-hero.g{order:2}
  .pills{gap:6px;padding:0 2px}
  .pills span{font-size:.68rem;padding:4px 9px}
  .filters{padding:10px 12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:stretch}
  .fi{width:100%;min-width:0;padding:9px 10px;font-size:.78rem}
  #fQ{grid-column:1/-1}
  .fi-sort{margin-left:0}
  .filters button{width:100%;min-height:38px;justify-content:center;text-align:center;white-space:normal}
  .grid-hdr{padding:12px 12px 5px}
  .cars-grid{grid-template-columns:1fr!important;gap:12px;padding:0 12px 70px}
  .car-card{border-radius:14px}
  .car-card:hover{transform:none}
  .cimg{height:205px}
  .cbody{padding:12px 13px}
  .ctitle{font-size:.95rem;white-space:normal;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .cprice{font-size:1.25rem}
  .cmeta span{font-size:.68rem}
  .cloc{font-size:.72rem;gap:8px}
  .overlay{padding:8px;align-items:flex-start;justify-content:center;overflow-y:auto}
  .modal,.modal-lg{width:100%;max-width:100%;max-height:calc(100dvh - 16px);border-radius:14px;overflow-y:auto}
  .mhdr{padding:13px 14px;top:0;z-index:3}
  .mhdr h2{font-size:.92rem;line-height:1.2;padding-right:8px}
  .mclose{width:34px;height:34px;border-radius:9px;flex:0 0 auto}
  .mbody{padding:14px}
  .mfoot{padding:12px 14px;flex-direction:column}
  .mfoot .btn{width:100%;justify-content:center;min-height:42px}
  .btn{min-height:40px;justify-content:center;text-align:center;white-space:normal}
  .frow{grid-template-columns:1fr}
  .pcards{grid-template-columns:1fr}
  .pgrid{grid-template-columns:repeat(2,1fr);gap:7px}
  #detailOv .modal{max-height:calc(100dvh - 16px)}
  #detailOv .mbody{padding:14px}
  #detailOv .dgal{margin:0 -14px 14px;padding:0 14px 7px;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
  #detailOv .dgal img{width:calc(100vw - 44px);min-width:calc(100vw - 44px);max-width:calc(100vw - 44px);height:auto;aspect-ratio:16/10;object-fit:cover;border-radius:10px;scroll-snap-align:start}
  #detailOv .dgrid{grid-template-columns:1fr 1fr;gap:9px;margin-bottom:13px}
  #detailOv .di{min-width:0}
  #detailOv .di span{font-size:.84rem;line-height:1.25;overflow-wrap:anywhere}
  #detailOv h3{font-size:1.05rem!important;line-height:1.25;overflow-wrap:anywhere}
  #detailOv .btn,#detailOv a.btn{width:100%;min-height:44px;justify-content:center}
  #detailOv .detail-actions{position:sticky;bottom:0;margin:12px -14px -14px;padding:10px 14px;background:linear-gradient(180deg,rgba(22,30,46,.88),var(--bg2));border-top:1px solid var(--border);z-index:2}
  #detailOv [style*="display:flex;gap:8px;margin-top:10px"]{flex-direction:column!important}
  #myOv .modal{max-height:calc(100dvh - 16px)}
  #myOv .lrow{display:grid;grid-template-columns:52px minmax(0,1fr);grid-template-areas:"foto info" "acciones acciones";gap:8px;align-items:center;padding:10px}
  #myOv .lrow>img,#myOv .lrow>div[style*="width:50px"]{grid-area:foto;width:52px!important;height:52px!important}
  #myOv .lrow-info{grid-area:info;min-width:0}
  #myOv .lrow>div:last-child{grid-area:acciones;width:100%;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:space-between!important;gap:8px}
  #myOv .lrow>div:last-child>div{display:flex!important;gap:6px!important;flex-wrap:wrap!important;justify-content:flex-end!important}
  #myOv .lrow .btn{min-height:32px!important;padding:6px 9px!important;font-size:.73rem!important}
  #myOv .lrow-s{font-size:.68rem;white-space:nowrap}
  .inventory-notice{margin:10px 12px 0;font-size:.78rem}
  .inventory-notice button{display:block;margin:8px 0 0;width:100%}
  #adminOv .mbody{overflow-x:auto}
  .atable{min-width:620px}
  .ai-fab{right:16px;bottom:16px;width:54px;height:54px}
  .ai-panel{width:calc(100vw - 24px);right:12px;bottom:78px;height:min(510px,calc(100dvh - 96px))}
  footer{grid-template-columns:1fr;padding:26px 16px;gap:16px}
  .toast{max-width:calc(100vw - 24px);white-space:normal;text-align:center;bottom:14px}
}
@media (max-width: 430px){
  .hero h1{font-size:1.86rem}
  .filters{grid-template-columns:1fr}
  .filters button{grid-column:auto}
  .cimg{height:190px}
  #detailOv .dgrid{grid-template-columns:1fr}
  #detailOv .dgal img{width:calc(100vw - 36px);min-width:calc(100vw - 36px);max-width:calc(100vw - 36px)}
  #myOv .lrow>div:last-child{align-items:flex-start!important;flex-direction:column!important}
  #myOv .lrow>div:last-child>div{justify-content:flex-start!important}
}
@media (max-width: 360px){
  .hbtn{font-size:.68rem;padding:7px 6px}
  .hero h1{font-size:1.68rem}
  .cimg{height:175px}
}
</style>
