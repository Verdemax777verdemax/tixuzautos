<!-- DETAIL -->
<div class="overlay" id="detailOv">
<div class="modal modal-lg">
  <div class="mhdr"><h2 id="detailTitle">Detalle</h2><button class="mclose" onclick="closeO('detailOv')">✕</button></div>
  <div class="mbody" id="detailBody"></div>
</div></div>

<!-- SELL -->
<div class="overlay" id="sellOv">
<div class="modal">
  <div class="mhdr"><h2>Publicar mi auto</h2><button class="mclose" onclick="closeO('sellOv')">✕</button></div>
  <div class="mbody">
    <div class="steps">
      <div class="stab active" id="st1">1 · Info</div>
      <div class="stab" id="st2">2 · Fotos</div>
      <div class="stab" id="st3">3 · Publicar</div>
    </div>
    <!-- STEP 1 -->
    <div id="sp1">
      <div class="frow">
        <div class="fg"><label>Marca *</label><input id="sMake" placeholder="Toyota, Honda…"></div>
        <div class="fg"><label>Modelo *</label><input id="sModel" placeholder="Corolla, Civic…"></div>
      </div>
      <div class="frow">
        <div class="fg"><label>Año *</label><input id="sYear" type="number" placeholder="2020" min="1980" max="2027"></div>
        <div class="fg"><label>Precio MXN *</label><input id="sPrice" type="number" placeholder="200000"></div>
      </div>
      <div class="frow">
        <div class="fg"><label>Kilometraje</label><input id="sMileage" type="number" placeholder="50000"></div>
        <div class="fg"><label>Transmisión</label><select id="sTrans"><option>Automática</option><option>Manual</option><option>CVT</option></select></div>
      </div>
      <div class="frow">
        <div class="fg"><label>Combustible</label><select id="sFuel"><option>Gasolina</option><option>Diésel</option><option>Híbrido</option><option>Eléctrico</option></select></div>
        <div class="fg"><label>Color</label><input id="sColor" placeholder="Blanco"></div>
      </div>
      <div class="fg"><label>Estado / Ciudad</label><input id="sLoc" placeholder="Guadalajara, Jalisco"></div>
      <div class="fg"><label>Descripción</label><textarea id="sDesc" rows="3" placeholder="Condición, extras, historial…"></textarea></div>
      <div class="ferr" id="e1"></div>
    </div>
    <!-- STEP 2 -->
    <div id="sp2" style="display:none">
      <p style="font-size:.78rem;color:var(--text2);margin-bottom:10px">Sube fotos reales del auto · quedan en revisión manual antes de publicarse · JPG/PNG/WebP · se optimizan automáticamente</p>
      <div class="pgrid" id="photoGrid"></div>
      <input type="file" id="photoInput" multiple accept="image/jpeg,image/png,image/webp" style="display:none" onchange="handlePhotos(event)">
      <button class="btn btn-ghost" onclick="document.getElementById('photoInput').click()" style="width:100%">Agregar fotos</button>
      <div id="upStat" style="margin-top:6px;font-size:.74rem;color:var(--text3)"></div>
    </div>
    <!-- STEP 3 -->
    <div id="sp3" style="display:none">
      <div class="fg"><label>Tu nombre *</label><input id="sName" placeholder="Juan Pérez"></div>
      <div class="fg"><label>WhatsApp (10 dígitos) *</label><input id="sWA" type="tel" maxlength="10" placeholder="3310001234"></div>
      <div class="fg"><label>Tipo de vendedor</label><select id="sType"><option>Particular</option><option>Agencia</option><option>Distribuidor</option></select></div>
      <div class="fg">
        <label style="color:#fbbf24">PIN de 4 dígitos *</label>
        <div style="position:relative">
          <input id="sPin" type="password" maxlength="4" placeholder="••••" inputmode="numeric" autocomplete="off" style="padding-right:40px;width:100%">
          <button type="button" onclick="togglePin('sPin',this)" tabindex="-1" title="Mostrar/ocultar PIN" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:transparent;border:0;color:#fbbf24;cursor:pointer;font-size:1.1rem;padding:4px 6px;line-height:1">👁</button>
        </div>
        <div class="fhint" style="color:#fbbf24;font-weight:600">Guarda este PIN de 4 dígitos. Es tu llave para gestionar el anuncio. Si lo olvidas, contáctanos en soporte@tixuzautos.com</div>
      </div>
      <p style="font-size:.78rem;font-weight:700;color:var(--text2);margin:14px 0 8px">Elige tu plan</p>
      <div class="pcards" id="planCards"><div style="color:var(--text3);grid-column:1/-1;text-align:center">Cargando…</div></div>
      <div class="fhint" style="margin-top:10px;color:var(--text3)">Tu anuncio pasa a revisión manual al publicarse. Revisamos las fotos antes de activarlo. Al publicar aceptas los Términos y el Aviso de Privacidad.</div>
      <div class="ferr" id="e3"></div>
    </div>
  </div>
  <div class="mfoot">
    <button class="btn btn-ghost" id="btnBack" style="display:none" onclick="stepBack()">← Atrás</button>
    <button class="btn btn-primary" id="btnNext" onclick="stepNext()">Siguiente →</button>
  </div>
</div></div>

