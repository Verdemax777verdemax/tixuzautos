  <button onclick="openFullSearchAI()" title="Buscar con IA en todo internet" style="background:linear-gradient(135deg,var(--accent),var(--purple));border:0;color:#fff;padding:7px 12px;border-radius:8px;font-size:.78rem;font-weight:700;cursor:pointer;white-space:nowrap;box-shadow:0 4px 12px rgba(59,130,246,.3)">Buscar con IA</button>
