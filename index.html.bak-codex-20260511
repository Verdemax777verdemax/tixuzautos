async function aiRespond(val){
  const low=val.toLowerCase();
    // ── INICIO — detecta marca directo ──
  if(aiStep===0){
    const matchMarca=MARCAS.find(m=>m.toLowerCase()===low)||MARCAS.find(m=>low.includes(m.toLowerCase()));
